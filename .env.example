# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# --- LLM (D25: Google AI Studio, Gemini free tier) ---
GEMINI_API_KEY=replace-me
AGENT_MODEL=gemini-flash-latest

# --- MLflow (D8) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Airflow 3 REST API (D9) ---
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=replace-me
AIRFLOW_PASSWORD=replace-me
AIRFLOW_APPROVED_DAGS=ml_training_pipeline

# --- Kubernetes (D11-D13) ---
K8S_NAMESPACE=mlops-demo
K8S_ALLOWED_NAMESPACES=mlops-demo
K8S_CONTEXT=kind-mlops

# --- Agent runtime ---
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_MAX_ITERATIONS=12
LOG_LEVEL=INFO

# --- Local infra (docker compose) ---
AIRFLOW_JWT_SECRET=replace-me-with-random-string
MLFLOW_VERSION=3.18.0
